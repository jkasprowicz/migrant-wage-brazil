import pandas as pd

# 1. Carregar o arquivo CSV (ajuste o separador se necessário: sep=';' ou sep=',')
# Usamos 'on_bad_lines="skip"' para evitar o erro de tokenização que ocorreu antes
try:
    df = pd.read_csv('CAGED_Consolidado_2011_2025_Final.csv', sep=';', on_bad_lines='skip')
except:
    df = pd.read_csv('CAGED_Consolidado_2011_2025_Final.csv', sep=',', on_bad_lines='skip')

# Garantir que a coluna de salário seja numérica (convertendo eventuais strings/vírgulas)
if df['salario_num'].dtype == object:
    df['salario_num'] = df['salario_num'].astype(str).str.replace(',', '.').astype(float)

salario_col = 'salario_num' # ou 'salario_mensal' se preferir

print("--- 1. Análise Cruzada por Categoria ---")
analise_categoria = df.groupby('categoria')[salario_col].agg(
    minimo='min',
    media='mean',
    mediana='median',
    maximo='max'
).reset_index()
display(analise_categoria)

print("--- 2. Análise Cruzada por Sexo ---")
# Você pode usar 'sexo' ou 'sexo_clean'
analise_sexo = df.groupby('sexo')[salario_col].agg(
    minimo='min',
    media='mean',
    mediana='median',
    maximo='max'
).reset_index()
display(analise_sexo)

print("--- 3. Análise Cruzada por País ---")
analise_pais = df.groupby('pais')[salario_col].agg(
    minimo='min',
    media='mean',
    mediana='median',
    maximo='max'
).reset_index()
display(analise_pais)

print("--- 4. Análise Cruzada Dupla (Categoria e Sexo) ---")
analise_cat_sexo = df.groupby(['categoria', 'sexo'])[salario_col].agg(
    minimo='min',
    media='mean',
    mediana='median',
    maximo='max'
).reset_index()
display(analise_cat_sexo)


import pandas as pd
import numpy as np

# 1. Carregar o arquivo original (tratando eventuais separadores e erros de linha)
try:
    df = pd.read_csv('CAGED_Consolidado_2011_2025_Final.csv', sep=';', on_bad_lines='skip')
except:
    df = pd.read_csv('CAGED_Consolidado_2011_2025_Final.csv', sep=',', on_bad_lines='skip')

# Definir qual coluna de salário utilizar
if 'salario_num' in df.columns:
    salario_col = 'salario_num'
elif 'salario_mensal' in df.columns:
    salario_col = 'salario_mensal'
else:
    salario_col = df.select_dtypes(include=[np.number]).columns[0]

# Converter valores de salário para numérico caso estejam como string
if df[salario_col].dtype == object:
    df[salario_col] = df[salario_col].astype(str).str.replace(',', '.').astype(float)

print(f"Utilizando a coluna '{salario_col}' para os cálculos salariais.\n")

# ==========================================
# 2. Cruzamento 1: Por Categoria
# ==========================================
analise_categoria = df.groupby('categoria')[salario_col].agg(
    minimo='min',
    media='mean',
    mediana='median',
    maximo='max'
).reset_index()
analise_categoria.to_csv('analise_salarios_por_categoria.csv', index=False, encoding='utf-8-sig')
print("-> Salvo: analise_salarios_por_categoria.csv")

# ==========================================
# 3. Cruzamento 2: Por Sexo
# ==========================================
analise_sexo = df.groupby('sexo')[salario_col].agg(
    minimo='min',
    media='mean',
    mediana='median',
    maximo='max'
).reset_index()
analise_sexo.to_csv('analise_salarios_por_sexo.csv', index=False, encoding='utf-8-sig')
print("-> Salvo: analise_salarios_por_sexo.csv")

# ==========================================
# 4. Cruzamento 3: Por País
# ==========================================
analise_pais = df.groupby('pais')[salario_col].agg(
    minimo='min',
    media='mean',
    mediana='median',
    maximo='max'
).reset_index()
analise_pais.to_csv('analise_salarios_por_pais.csv', index=False, encoding='utf-8-sig')
print("-> Salvo: analise_salarios_por_pais.csv")

# ==========================================
# 5. Cruzamento 4: Categoria (cruzando Categoria e Sexo)
# ==========================================
analise_categoria_dupla = df.groupby(['categoria', 'sexo'])[salario_col].agg(
    minimo='min',
    media='mean',
    mediana='median',
    maximo='max'
).reset_index()
analise_categoria_dupla.to_csv('analise_salarios_por_categoria_e_sexo.csv', index=False, encoding='utf-8-sig')
print("-> Salvo: analise_salarios_por_categoria_e_sexo.csv")

print("\nProcesso concluído! Todos os arquivos CSV estão disponíveis na barra lateral esquerda do seu Jupyter para download.")


