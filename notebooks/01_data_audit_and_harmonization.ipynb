# 5. DIAGNÓSTICO DE COMPLETUDE, AUSÊNCIAS OCULTAS E DUPLICIDADES
# ------------------------------------------------------------------------------
print("\n=== 5. VALORES AUSENTES E DUPLICIDADES ===")

dup_linhas = df_raw.duplicated().sum()
pct_dup = (dup_linhas / len(df_raw)) * 100
print(f"Linhas Totalmente Duplicadas: {dup_linhas:,} ({pct_dup:.2f}%)")

# Checagem de nulos semânticos (textos vazios/falsos nulos)
textos_nulos = ["", " ", "NA", "N/A", "NULL", "null", "Não informado", "Ignorado", "Sem informação", "999999", "-1"]
ocultos_dict = {}

for col in df_raw.select_dtypes(include=['object']).columns:
    qtd_oculta = df_raw[col].astype(str).str.strip().isin(textos_nulos).sum()
    if qtd_oculta > 0:
        ocultos_dict[col] = qtd_oculta

df_ocultos = pd.DataFrame(list(ocultos_dict.items()), columns=['Coluna', 'Qtd_Nulos_Ocultos'])
df_ocultos['%_Nulos_Ocultos'] = (df_ocultos['Qtd_Nulos_Ocultos'] / len(df_raw)) * 100
print("\n--- Ausências Ocultas Encontradas (Falsos Preenchimentos) ---")
display(df_ocultos)

