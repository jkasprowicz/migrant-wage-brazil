# 4. ESTRUTURA DO DATASET E CLASSIFICAÇÃO AUTOMÁTICA
# ------------------------------------------------------------------------------
print("\n=== 4. ESTRUTURA DO DATASET & DICIONÁRIO DE DADOS INICIAL ===")

estrutura_cols = []
for col in df_raw.columns:
    nulos = df_raw[col].isnull().sum()
    pct_nulos = (nulos / len(df_raw)) * 100
    uniques = df_raw[col].nunique(dropna=True)
    pct_uniques = (uniques / len(df_raw)) * 100
    exemplo = str(df_raw[col].dropna().iloc[0]) if not df_raw[col].dropna().empty else "N/A"

    estrutura_cols.append({
        'Coluna': col,
        'Tipo': str(df_raw[col].dtype),
        'Nulos': nulos,
        '%_Nulos': round(pct_nulos, 2),
        'Unicos': uniques,
        '%_Unicos': round(pct_uniques, 4),
        'Exemplo': exemplo[:30],
        'Possivel_Significado': "Significado não determinado — necessita documentação/dicionário de dados."
    })

df_estrutura = pd.DataFrame(estrutura_cols)
display(df_estrutura)

def mapear_colunas_caged(df):
    mapeamento = {}
    termos_chave = {
        'salario': ['salario', 'valorsalario', 'salariomensal', 'vlremunerafxa', 'remuneracao'],
        'saldo': ['saldo', 'saldomovimentacao', 'tipomovimentacao', 'admissao/desligamento'],
        'uf': ['uf', 'siglauf', 'uf_nome', 'estado'],
        'municipio': ['municipio', 'codmunicipio', 'município'],
        'idade': ['idade', 'tpidade'],
        'sexo': ['sexo', 'genero', 'tpsexo'],
        'escolaridade': ['escolaridade', 'instrucao', 'graudeinstrucao'],
        'cnae': ['cnae', 'cnae20subclas', 'secao', 'subsetor'],
        'cbo': ['cbo', 'cbo2002ocupacao', 'ocupacao']
    }
    for conceito, termos in termos_chave.items():
        for col in df.columns:
            if any(term in col.lower() for term in termos):
                mapeamento[conceito] = col
                break
    return mapeamento

cols_map = mapear_colunas_caged(df_raw)
print("\n=== COLUNAS CHAVE MAPEADAS DINAMICAMENTE ===")
for k, v in cols_map.items():
    print(f"  ➜ {k.upper()}: {v}")


