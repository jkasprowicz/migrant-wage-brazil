print("=== 2. INVENTÁRIO COMPLETO DOS ARQUIVOS ===")

def inventariar_arquivos(caminho_raiz):
    extensoes = ['*.csv', '*.xlsx', '*.xls', '*.txt']
    arquivos_encontrados = []
    for ext in extensoes:
        arquivos_encontrados.extend(glob.glob(os.path.join(caminho_raiz, '**', ext), recursive=True))

    inventario = []
    for filepath in arquivos_encontrados:
        tamanho_mb = os.path.getsize(filepath) / (1024 * 1024)
        nome = os.path.basename(filepath)
        ext = os.path.splitext(nome)[1]
        pasta_pai = os.path.basename(os.path.dirname(filepath))

        inventario.append({
            'Caminho_Completo': filepath,
            'Arquivo': nome,
            'Subpasta': pasta_pai,
            'Extensao': ext,
            'Tamanho_MB': round(tamanho_mb, 2)
        })
    return pd.DataFrame(inventario)

df_inventario = inventariar_arquivos(CAMINHO_BASE)
print(f"Total de arquivos encontrados: {len(df_inventario)}")
