# 6. ESTATÍSTICA DESCRITIVA E REMUNERAÇÃO
# ------------------------------------------------------------------------------
print("\n=== 6. ESTATÍSTICA DESCRITIVA E REMUNERAÇÃO ===")

df_proc = df_raw.copy()

# Processamento dinâmico de remuneração
if 'salario' in cols_map:
    col_sal = cols_map['salario']
    df_proc['salario_num'] = pd.to_numeric(df_proc[col_sal].astype(str).str.replace(',', '.'), errors='coerce')

    sal_series = df_proc['salario_num'].dropna()
    print(f"Análise da Variável Salarial: {col_sal}")
    print(f"Média: R$ {sal_series.mean():,.2f}")
    print(f"Mediana: R$ {sal_series.median():,.2f}")
    print(f"Desvio Padrão: R$ {sal_series.std():,.2f}")
    print(f"Mínimo: R$ {sal_series.min():,.2f} | Máximo: R$ {sal_series.max():,.2f}")

    p95 = sal_series.quantile(0.95)
    plt.figure(figsize=(10, 4))
    sns.histplot(sal_series[sal_series <= p95], bins=40, kde=True, color='teal')
    plt.title(f'Distribuição Salarial (Até Percentil 95: R$ {p95:,.2f})')
    plt.xlabel('Salário (R$)')
    plt.show()

# Resumo numérico global
display(df_proc.describe().T)


# ------------------------------------------------------------------------------
# 7. DETECÇÃO MULTIVARIADA DE ANOMALIAS (ISOLATION FOREST)
# ------------------------------------------------------------------------------
print("\n=== 7. DETECÇÃO PREDITIVA DE ANOMALIAS (MACHINE LEARNING) ===")

cols_num = df_proc.select_dtypes(include=[np.number]).dropna(axis=1).columns.tolist()

if len(cols_num) >= 2:
    # Amostra para performance em volumetrias pesadas
    df_sample = df_proc[cols_num].sample(n=min(100000, len(df_proc)), random_state=42)

    iso = IsolationForest(contamination=0.01, random_state=42, n_jobs=-1)
    df_sample['anomalia'] = iso.fit_predict(df_sample)

    total_anom = (df_sample['anomalia'] == -1).sum()
    print(f"Anomalias multivariadas detectadas no modelo: {total_anom:,} registros ({total_anom/len(df_sample)*100:.2f}%)")

    plt.figure(figsize=(8, 4))
    sns.scatterplot(data=df_sample, x=cols_num[0], y=cols_num[1], hue='anomalia', palette={1: 'gray', -1: 'red'}, alpha=0.5)
    plt.title('Detecção Multivariada de Anomalias (Isolation Forest - 1% Contaminação)')
    plt.show()
else:
    print("[INFO] Variáveis numéricas completas insuficientes para modelo multivariado.")


# ------------------------------------------------------------------------------
# 8. DATA QUALITY SCORE E GOVERNANÇA
# ------------------------------------------------------------------------------
print("\n=== 8. DIAGNÓSTICO DE DATA QUALITY SCORE ===")

pct_completude = 100 - df_estrutura['%_Nulos'].mean()
pct_unicidade = 100 - pct_dup
pct_validade = 100.0

if 'salario_num' in df_proc.columns:
    inv = (df_proc['salario_num'] <= 0).sum()
    pct_validade = 100 - ((inv / len(df_proc)) * 100)

score_geral = (pct_completude * 0.4) + (pct_unicidade * 0.3) + (pct_validade * 0.3)

df_score = pd.DataFrame([
    {'Dimensao': 'Completude', 'Indicador': '% Médio de Células Preenchidas', 'Resultado': f"{pct_completude:.2f}%", 'Status': 'Bom' if pct_completude > 80 else 'Atenção'},
    {'Dimensao': 'Unicidade', 'Indicador': '% Registros Não Duplicados', 'Resultado': f"{pct_unicidade:.2f}%", 'Status': 'Excelente' if pct_unicidade > 98 else 'Atenção'},
    {'Dimensao': 'Validade', 'Indicador': '% Salários > 0', 'Resultado': f"{pct_validade:.2f}%", 'Status': 'Excelente' if pct_validade > 95 else 'Crítico'},
    {'Dimensao': 'DATA QUALITY SCORE', 'Indicador': 'Pontuação Ponderada Final', 'Resultado': f"{score_geral:.2f} / 100", 'Status': 'APROVADO' if score_geral > 80 else 'REQUER TRATAMENTO'}
])
display(df_score)


