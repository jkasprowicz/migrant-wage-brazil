# 3. LEITURA DEFENSIVA, TRATAMENTO DE ENCODING E DELIMITADORES
# ------------------------------------------------------------------------------
print("\n=== 3. LEITURA E VALIDAÇÃO DOS ARQUIVOS ===")

def carregar_arquivo_defensivo(filepath):
    """Detecta dinamicamente o encoding e delimitador sem quebrar a execução."""
    ext = os.path.splitext(filepath)[1].lower()
    if ext in ['.xlsx', '.xls']:
        df = pd.read_excel(filepath)
        return df, 'excel', 'utf-8'

    with open(filepath, 'rb') as f:
        rawdata = f.read(20000)
        encoding_detectado = chardet.detect(rawdata)['encoding'] or 'utf-8'

    separadores = [';', ',', '\t', '|']
    encodings = [encoding_detectado, 'utf-8', 'latin1', 'iso-8859-1', 'cp1252']

    for enc in encodings:
        for sep in separadores:
            try:
                df_test = pd.read_csv(filepath, sep=sep, encoding=enc, low_memory=False, on_bad_lines='skip', nrows=100)
                if df_test.shape[1] > 1:
                    df_full = pd.read_csv(filepath, sep=sep, encoding=enc, low_memory=False, on_bad_lines='skip')
                    return df_full, sep, enc
            except Exception:
                continue
    raise Exception(f"Não foi possível determinar o delimitador ou encoding de {filepath}")

lista_dfs = []
log_leitura = []

for idx, row in df_inventario.iterrows():
    caminho = row['Caminho_Completo']
    nome_arq = row['Arquivo']
    try:
        df_temp, sep_det, enc_det = carregar_arquivo_defensivo(caminho)
        df_temp['origem_pasta'] = row['Subpasta']
        df_temp['origem_arquivo'] = nome_arq

        lista_dfs.append(df_temp)
        log_leitura.append({'Arquivo': nome_arq, 'Status': 'Sucesso', 'Linhas': len(df_temp), 'Colunas': len(df_temp.columns), 'Separador': sep_det, 'Encoding': enc_det})
        print(f"✔ [OK] {nome_arq} | {len(df_temp):,} linhas | Separador: '{sep_det}' | Enc: '{enc_det}'")
    except Exception as e:
        log_leitura.append({'Arquivo': nome_arq, 'Status': f'Erro: {e}', 'Linhas': 0, 'Colunas': 0, 'Separador': 'N/A', 'Encoding': 'N/A'})
        print(f"✖ [ERRO] {nome_arq}: {e}")

df_raw = pd.concat(lista_dfs, ignore_index=True)
print(f"\n[SUCESSO] Total Consolidado: {len(df_raw):,} linhas e {len(df_raw.columns)} colunas.")


