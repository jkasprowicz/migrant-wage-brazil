import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import scipy.stats as stats

import gamlss as gl
from gamlss import gamlss, GAIC

base_salario = pd.read_parquet(
    "caged_salary_analysis.parquet"
)

print(base_salario.shape)

base_modelo = (
    base_salario[
        [
            "salario_consolidado",
            "sexo_clean",
            "escolaridade_clean",
            "faixa_etaria_harmonizada",
            "cbo_grupo"
        ]
    ]
    .dropna()
    .copy()
)

print("N da base final de modelagem:", len(base_modelo))

print("\nAusências:")
print(base_modelo.isna().sum())

for col in [
    "sexo_clean",
    "escolaridade_clean",
    "faixa_etaria_harmonizada",
    "cbo_grupo"
]:
    print("\n", col)
    print(base_modelo[col].value_counts())

formula_m0 = """
salario_consolidado ~ 1
"""

formula_m1 = """
salario_consolidado
~ C(sexo_clean)
+ C(escolaridade_clean)
+ C(faixa_etaria_harmonizada)
"""

formula_sigma = """
~ C(sexo_clean)
+ C(escolaridade_clean)
"""

formula_m3 = """
salario_consolidado
~ C(sexo_clean)
+ C(escolaridade_clean)
+ C(faixa_etaria_harmonizada)
+ C(cbo_grupo)
"""

m0_full = gamlss(
    formula_m0,
    family=gl.BCT(),
    data=base_modelo,
    n_cyc=100
)

print("M0 concluído")
print("Deviance:", m0_full.G_deviance)
print("GAIC:", GAIC(m0_full, k=2))
print("SBC:", m0_full.sbc)
print("df:", m0_full.df_fit)

m1_full = gamlss(
    formula_m1,
    family=gl.BCT(),
    data=base_modelo,
    n_cyc=100
)

print("M1 concluído")
print("Deviance:", m1_full.G_deviance)
print("GAIC:", GAIC(m1_full, k=2))
print("SBC:", m1_full.sbc)
print("df:", m1_full.df_fit)

m2_full = gamlss(
    formula_m1,
    sigma_formula=formula_sigma,
    family=gl.BCT(),
    data=base_modelo,
    n_cyc=100
)

print("M2 concluído")
print("Deviance:", m2_full.G_deviance)
print("GAIC:", GAIC(m2_full, k=2))
print("SBC:", m2_full.sbc)
print("df:", m2_full.df_fit)

m3_full = gamlss(
    formula_m3,
    sigma_formula=formula_sigma,
    family=gl.BCT(),
    data=base_modelo,
    n_cyc=100
)

print("M3 concluído")
print("Deviance:", m3_full.G_deviance)
print("GAIC:", GAIC(m3_full, k=2))
print("SBC:", m3_full.sbc)
print("df:", m3_full.df_fit)

  comparacao_full = pd.DataFrame({
    "modelo": ["M0", "M1", "M2", "M3"],
    "descricao": [
        "Intercepto",
        "Sexo + escolaridade + faixa etária",
        "M1 + sigma por sexo e escolaridade",
        "M2 + grande grupo CBO"
    ],
    "N": [len(base_modelo)] * 4,
    "deviance": [
        m0_full.G_deviance,
        m1_full.G_deviance,
        m2_full.G_deviance,
        m3_full.G_deviance
    ],
    "GAIC": [
        GAIC(m0_full, k=2),
        GAIC(m1_full, k=2),
        GAIC(m2_full, k=2),
        GAIC(m3_full, k=2)
    ],
    "SBC": [
        m0_full.sbc,
        m1_full.sbc,
        m2_full.sbc,
        m3_full.sbc
    ],
    "df": [
        m0_full.df_fit,
        m1_full.df_fit,
        m2_full.df_fit,
        m3_full.df_fit
    ]
})

comparacao_full["delta_GAIC"] = (
    comparacao_full["GAIC"]
    - comparacao_full["GAIC"].min()
)

comparacao_full

from scipy.stats import chi2

def lr_test(model_reduced, model_full):
    LR = model_reduced.G_deviance - model_full.G_deviance
    df_diff = model_full.df_fit - model_reduced.df_fit
    p = chi2.sf(LR, df_diff)

    return {
        "LR": LR,
        "df": df_diff,
        "p": p
    }

print("M0 vs M1:", lr_test(m0_full, m1_full))
print("M1 vs M2:", lr_test(m1_full, m2_full))
print("M2 vs M3:", lr_test(m2_full, m3_full))

residuos_m3 = pd.Series(
    m3_full.get_residuals(),
    name="residuo"
)

residuos_m3.describe()

import matplotlib.pyplot as plt

plt.figure(figsize=(8, 5))
plt.hist(residuos_m3, bins=100)
plt.xlabel("Resíduo quantílico normalizado")
plt.ylabel("Frequência")
plt.title("Distribuição dos resíduos — M3")
plt.show()

import scipy.stats as stats
import matplotlib.pyplot as plt

plt.figure(figsize=(7, 7))
stats.probplot(residuos_m3, dist="norm", plot=plt)
plt.title("QQ-plot dos resíduos — M3")
plt.show()

m3_full.summary()
