import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import scipy.stats as stats

import gamlss as gl
from gamlss import gamlss, GAIC

df_raw = pd.read_csv(
    "CAGED_Consolidado_2011_2025_Final.csv",
    sep=";",
    low_memory=False
)

print(df_raw.shape)

df_raw["ano_analise"] = (
    df_raw["competencia"]
    .astype(str)
    .str[:4]
    .astype(int)
)

def harmonizar_faixa_etaria(x):
    if pd.isna(x):
        return None

    x = str(x).strip()

    mapa = {
        "01": "Menor de 18",
        "02": "18 a 24",
        "03": "25 a 29",
        "04": "30 a 39",
        "05": "40 a 49",
        "06": "50 a 64",
        "07": "65 ou mais",

        "1": "Menor de 18",
        "2": "18 a 24",
        "3": "25 a 29",
        "4": "30 a 39",
        "5": "40 a 49",
        "6": "50 a 64",
        "7": "65 ou mais",

        "0NA": None,
        "8": None,
    }

    return mapa.get(x)

df_raw["faixa_etaria_harmonizada"] = (
    df_raw["faixa_etaria"]
    .apply(harmonizar_faixa_etaria)
)

df_raw["cbo_codigo6"] = (
    pd.to_numeric(df_raw["cbo_ocupacao"], errors="coerce")
    .astype("Int64")
    .astype(str)
    .str.replace("<NA>", "", regex=False)
    .str.zfill(6)
)

df_raw["cbo_grupo"] = (
    df_raw["cbo_codigo6"]
    .str[0]
    .replace("", pd.NA)
)

auditoria = []

def registrar(etapa, dados):
    auditoria.append({
        "etapa": etapa,
        "n": len(dados)
    })
    print(f"{etapa:<35} {len(dados):>12,}")

base = df_raw.copy()
registrar("Base original", base)

admissao_antigo = (
    (base["ano_analise"] <= 2019)
    & (base["movimento"] == 1)
)

admissao_novo = (
    (base["ano_analise"] >= 2020)
    & (base["saldo_movimentacao_clean"] == 1)
    & (~base["origem_arquivo"].str.contains("_EXC", na=False))
)

base["admissao_analise"] = admissao_antigo | admissao_novo

base_salario = base.loc[base["admissao_analise"]].copy()

registrar("Admissões", base_salario)

base_salario = base_salario.loc[
    base_salario["pais"] != "NATURALIDADE BRASILEIRA"
].copy()

registrar("Sem naturalizados", base_salario)

transferencia = (
    base_salario["ano_analise"].between(2012, 2019)
    & base_salario["tipo_mov_desagregado"].isin([3, 9])
)

base_salario = base_salario.loc[~transferencia].copy()

registrar("Sem transferências", base_salario)

base_salario = base_salario.loc[
    base_salario["indtrabintermitente"].ne(1)
    | base_salario["indtrabintermitente"].isna()
].copy()

registrar("Sem intermitentes", base_salario)

print(base_salario["competencia"].dtype)
print(base_salario["competencia"].head())

base_salario["salario_minimo"] = (
